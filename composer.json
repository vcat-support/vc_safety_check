{
    "name": "vcat/vc-safety-check",
    "type": "typo3-cms-extension",
    "description": "Checks all installed extensions, core packages and their dependencies for known security vulnerabilities via our API, stores the results and displays them in a dashboard widget.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://typo3-status.com/typo3-safety-check-information/",
    "authors": [
        {
            "name": "VCAT Consulting GmbH",
            "email": "info@vcat.de",
            "role": "Company"
        },
        {
            "name": "Joram Wittke",
            "email": "team.t3@vcat.de",
            "role": "Developer"
        },
        {
            "name": "Nico Hoffmann",
            "email": "team.t3@vcat.de",
            "role": "Developer"
        },
        {
            "name": "Patrick Schwalger",
            "email": "team.t3@vcat.de",
            "role": "Consultant"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-dashboard": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-scheduler": "^12.4 || ^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "Vcat\\Vcsafetycheck\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "vc_safety_check"
        }
    }
}
